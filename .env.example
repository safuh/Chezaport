APP_NAME=Chezaport
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
DATABASE_URL=sqlite+aiosqlite:///./backbone.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
LOG_LEVEL=INFO
LOG_JSON=false
# Enable built-in registration/login, role-aware operator endpoints, and admin API.
# Generate at least 32 random characters; never commit the real value.
# JWT_SECRET_KEY=generate-a-high-entropy-secret-in-your-deployment-environment
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Optional football-data.org v4 read-only provider integration.
# Enable only after confirming provider terms for your intended display/use.
# FOOTBALL_DATA_API_TOKEN=
# FOOTBALL_DATA_COMPETITION_CODES=["PL"]
