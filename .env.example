APP_NAME=Chezaport
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
DATABASE_URL=sqlite+aiosqlite:///./backbone.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
LOG_LEVEL=INFO
LOG_JSON=false
# ChezaPort v1 is public/read-only: end users do not need accounts or sign-in.
# Leave JWT_SECRET_KEY unset; identity is deferred to a later release.
# JWT_SECRET_KEY=generate-a-high-entropy-secret-in-your-deployment-environment
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Optional football-data.org v4 read-only football data provider.
# Create the provider account for this application and store its token here.
# Never put the token in frontend code, Git, screenshots, or chat.
# FOOTBALL_DATA_API_TOKEN=
# FOOTBALL_DATA_COMPETITION_CODES=["PL"]
